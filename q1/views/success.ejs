<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registration Details - Q1</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f7f6; margin: 0; padding: 40px; display: flex; justify-content: center; }
    .card { background: white; width: 100%; max-width: 800px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); padding: 30px; }
    h2 { color: #2e7d32; text-align: center; margin-bottom: 20px; }
    .success-alert { background-color: #d4edda; color: #155724; padding: 12px; border-radius: 5px; text-align: center; margin-bottom: 25px; font-weight: 500; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
    th, td { border: 1px solid #ddd; padding: 12px 15px; text-align: left; }
    th { background-color: #f8f9fa; color: #333; font-weight: 600; width: 30%; }
    .img-preview { width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 2px solid #ddd; margin-right: 10px; margin-bottom: 10px; }
    .btn-download { display: inline-block; background-color: #0288d1; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 13px; margin-top: 5px; font-weight: 500; }
    .btn-download:hover { background-color: #0277bd; }
    .gallery { display: flex; flex-wrap: wrap; gap: 15px; }
    .img-container { display: flex; flex-direction: column; align-items: center; }
    .btn-back { display: inline-block; background-color: #757575; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; text-align: center; }
    .btn-back:hover { background-color: #616161; }
  </style>
</head>
<body>
  <div class="card">
    <h2>User Registration Summary</h2>
    <div class="success-alert">🎉 Registration Successful! Details saved cleanly.</div>

    <table>
      <tr>
        <th>Username</th>
        <td><%= user.username %></td>
      </tr>
      <tr>
        <th>Email Address</th>
        <td><%= user.email %></td>
      </tr>
      <tr>
        <th>Gender</th>
        <td><%= user.gender %></td>
      </tr>
      <tr>
        <th>Hobbies</th>
        <td><%= user.hobbies %></td>
      </tr>
      <tr>
        <th>Profile Picture (Single)</th>
        <td>
          <div class="img-container" style="display: inline-block;">
            <img src="<%= user.profilePic.path %>" alt="Profile Picture" class="img-preview"><br>
            <a href="/download/<%= user.profilePic.filename %>" class="btn-download">Download File 📥</a>
          </div>
        </td>
      </tr>
      <tr>
        <th>Other Pictures (Multiple)</th>
        <td>
          <% if (user.otherPics && user.otherPics.length > 0) { %>
            <div class="gallery">
              <% user.otherPics.forEach(pic => { %>
                <div class="img-container">
                  <img src="<%= pic.path %>" alt="Uploaded Pic" class="img-preview">
                  <a href="/download/<%= pic.filename %>" class="btn-download">Download 📥</a>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <span style="color: #888;">No additional pictures uploaded.</span>
          <% } %>
        </td>
      </tr>
    </table>

    <div style="text-align: center;">
      <a href="/" class="btn-back">Register Another User</a>
    </div>
  </div>
</body>
</html>
