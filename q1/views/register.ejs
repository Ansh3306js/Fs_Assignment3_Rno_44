<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Registration Form - Q1</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f7f6; margin: 0; padding: 30px; display: flex; justify-content: center; }
    .card { background: white; width: 100%; max-width: 650px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); padding: 30px; }
    h2 { color: #333; text-align: center; margin-bottom: 25px; font-weight: 600; border-bottom: 2px solid #4CAF50; padding-bottom: 10px; }
    .form-group { margin-bottom: 20px; }
    label { display: block; font-weight: 600; margin-bottom: 6px; color: #444; }
    input[type="text"], input[type="email"], input[type="password"] {
      width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px;
    }
    input[type="text"]:focus, input[type="email"]:focus, input[type="password"]:focus {
      border-color: #4CAF50; outline: none;
    }
    .radio-group, .checkbox-group { display: flex; gap: 15px; margin-top: 5px; }
    .radio-group label, .checkbox-group label { font-weight: normal; cursor: pointer; }
    .error-text { color: #d9534f; font-size: 13px; margin-top: 4px; font-weight: 500; }
    .global-error { background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 5px; margin-bottom: 20px; }
    .btn-submit { background-color: #4CAF50; color: white; border: none; padding: 12px 20px; width: 100%; font-size: 16px; font-weight: 600; border-radius: 5px; cursor: pointer; transition: 0.3s; }
    .btn-submit:hover { background-color: #45a049; }
    .hint { font-size: 12px; color: #777; margin-top: 2px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>User Registration Form</h2>

    <% if (fileErrors && fileErrors.length > 0) { %>
      <div class="global-error">
        <ul>
          <% fileErrors.forEach(err => { %>
            <li><%= err %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/register" method="POST" enctype="multipart/form-data">
      <!-- Username -->
      <div class="form-group">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" value="<%= oldInput.username || '' %>" placeholder="Enter username">
        <% if (errors.username) { %>
          <div class="error-text"><%= errors.username %></div>
        <% } %>
      </div>

      <!-- Email -->
      <div class="form-group">
        <label for="email">Email Address:</label>
        <input type="email" id="email" name="email" value="<%= oldInput.email || '' %>" placeholder="Enter email">
        <% if (errors.email) { %>
          <div class="error-text"><%= errors.email %></div>
        <% } %>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" placeholder="Enter password">
        <% if (errors.password) { %>
          <div class="error-text"><%= errors.password %></div>
        <% } %>
      </div>

      <!-- Confirm Password -->
      <div class="form-group">
        <label for="confirmPassword">Confirm Password:</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password">
        <% if (errors.confirmPassword) { %>
          <div class="error-text"><%= errors.confirmPassword %></div>
        <% } %>
      </div>

      <!-- Gender -->
      <div class="form-group">
        <label>Gender:</label>
        <div class="radio-group">
          <label><input type="radio" name="gender" value="Male" <%= oldInput.gender === 'Male' ? 'checked' : '' %>> Male</label>
          <label><input type="radio" name="gender" value="Female" <%= oldInput.gender === 'Female' ? 'checked' : '' %>> Female</label>
          <label><input type="radio" name="gender" value="Other" <%= oldInput.gender === 'Other' ? 'checked' : '' %>> Other</label>
        </div>
        <% if (errors.gender) { %>
          <div class="error-text"><%= errors.gender %></div>
        <% } %>
      </div>

      <!-- Hobbies -->
      <div class="form-group">
        <label>Hobbies:</label>
        <div class="checkbox-group">
          <% const userHobbies = oldInput.hobbies || []; %>
          <label><input type="checkbox" name="hobbies" value="Reading" <%= userHobbies.includes('Reading') ? 'checked' : '' %>> Reading</label>
          <label><input type="checkbox" name="hobbies" value="Sports" <%= userHobbies.includes('Sports') ? 'checked' : '' %>> Sports</label>
          <label><input type="checkbox" name="hobbies" value="Music" <%= userHobbies.includes('Music') ? 'checked' : '' %>> Music</label>
          <label><input type="checkbox" name="hobbies" value="Travel" <%= userHobbies.includes('Travel') ? 'checked' : '' %>> Travel</label>
        </div>
        <% if (errors.hobbies) { %>
          <div class="error-text"><%= errors.hobbies %></div>
        <% } %>
      </div>

      <!-- Single Profile Pic Upload -->
      <div class="form-group">
        <label for="profilePic">Upload Profile Picture (Single File):</label>
        <input type="file" id="profilePic" name="profilePic" accept="image/*">
        <div class="hint">Allowed types: JPG, PNG, GIF, WEBP</div>
      </div>

      <!-- Multiple Other Pics Upload -->
      <div class="form-group">
        <label for="otherPics">Upload Other Pictures (Multiple Files):</label>
        <input type="file" id="otherPics" name="otherPics" accept="image/*" multiple>
        <div class="hint">You can select multiple images (up to 5)</div>
      </div>

      <button type="submit" class="btn-submit">Register Now</button>
    </form>
  </div>
</body>
</html>
