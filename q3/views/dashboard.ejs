<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Protected Dashboard - Q3 Redis</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background: #f4f7f6; margin: 0; padding: 0; }
    nav { background: #c0392b; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
    nav a { color: white; text-decoration: none; margin-left: 20px; font-weight: 500; }
    nav a.logout { background: #7f8c8d; padding: 6px 15px; border-radius: 4px; }
    .container { max-width: 800px; margin: 40px auto; background: white; padding: 30px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .badge { background: #e67e22; color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px; }
    .info-box { background: #fdf2e9; border-left: 4px solid #e67e22; padding: 15px; margin: 20px 0; border-radius: 4px; }
  </style>
</head>
<body>
  <nav>
    <div style="font-weight: bold; font-size: 18px;">Q3: Redis Session Store App</div>
    <div>
      <a href="/dashboard">Dashboard</a>
      <a href="/reports">Reports & Analytics</a>
      <a href="/logout" class="logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <h2>Protected Route 1: Dashboard <span class="badge">Redis Auth</span></h2>
    <p>Welcome back, <strong><%= user.name %></strong>!</p>

    <div class="info-box">
      <h4>🚀 Redis Session Engine Active</h4>
      <p>Session storage provider: <strong><%= storeType %></strong> using <code>connect-redis</code>.</p>
    </div>

    <h3>User Details</h3>
    <ul>
      <li>Username: <%= user.username %></li>
      <li>Email: <%= user.email %></li>
      <li>Role: <%= user.role %></li>
    </ul>

    <p><a href="/reports">Go to Protected Route 2: Reports Page &rarr;</a></p>
  </div>
</body>
</html>
